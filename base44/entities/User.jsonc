{
  "name": "User",
  "type": "object",
  "properties": {
    "user_role": {
      "type": "string",
      "enum": [
        "exhibitor",
        "buyer"
      ],
      "description": "App-level role: exhibitor or buyer"
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    },
    "profile_id": {
      "type": "string",
      "description": "ID of the linked ExhibitorProfile or BuyerProfile"
    }
  }
}