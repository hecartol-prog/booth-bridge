{
  "name": "BuyerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User id"
    },
    "job_title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "company_address": {
      "type": "string",
      "description": "Full company address"
    },
    "country": {
      "type": "string"
    },
    "industry": {
      "type": "string",
      "description": "Buyer's industry sector"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Products or categories the buyer is interested in"
    },
    "digital_card": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "user_id"
  ]
}