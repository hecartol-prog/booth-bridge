{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "organizer": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "past"
      ],
      "default": "upcoming"
    }
  },
  "required": [
    "name"
  ]
}