{
  "name": "BillingTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "subscription_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal"
      ]
    },
    "provider_transaction_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "charge",
        "refund",
        "credit",
        "dispute"
      ],
      "default": "charge"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "pending",
        "refunded"
      ],
      "default": "pending"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "description": {
      "type": "string"
    },
    "invoice_url": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}