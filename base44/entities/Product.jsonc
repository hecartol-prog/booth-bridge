{
  "name": "Product",
  "type": "object",
  "properties": {
    "exhibitor_user_id": {
      "type": "string"
    },
    "exhibitor_profile_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    }
  },
  "required": [
    "exhibitor_user_id",
    "title",
    "image_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.exhibitor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.exhibitor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.exhibitor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}