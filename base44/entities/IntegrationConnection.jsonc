{
  "name": "IntegrationConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "salesforce",
        "hubspot",
        "google_calendar",
        "outlook",
        "calendly",
        "microsoft_teams",
        "zoom",
        "whatsapp_business",
        "linkedin",
        "sharepoint",
        "onedrive",
        "dropbox",
        "box",
        "sap",
        "oracle",
        "dynamics"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error",
        "pending"
      ],
      "default": "pending"
    },
    "display_name": {
      "type": "string"
    },
    "account_identifier": {
      "type": "string",
      "description": "Email or account name shown to user"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "records_synced": {
      "type": "number",
      "default": 0
    },
    "failed_syncs": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "description": "Provider-specific settings JSON"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "provider"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}