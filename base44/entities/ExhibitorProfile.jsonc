{
  "name": "ExhibitorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User id"
    },
    "company_name": {
      "type": "string"
    },
    "booth_number": {
      "type": "string"
    },
    "hall": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "product_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main product categories"
    },
    "factory_type": {
      "type": "string",
      "enum": [
        "manufacturer",
        "trading_company",
        "both",
        "agent"
      ],
      "default": "manufacturer"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. ISO9001, FSC, CE"
    },
    "catalogue_url": {
      "type": "string"
    },
    "team_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails invited to team"
    },
    "digital_card": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "user_id",
    "company_name",
    "booth_number",
    "event_name"
  ]
}