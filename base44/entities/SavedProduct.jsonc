{
  "name": "SavedProduct",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "exhibitor_user_id": {
      "type": "string"
    },
    "exhibitor_company": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "product_image_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "collection": {
      "type": "string"
    },
    "interest_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    }
  },
  "required": [
    "buyer_id",
    "product_id"
  ]
}