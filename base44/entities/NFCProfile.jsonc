{
  "name": "NFCProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "nfc_identifier": {
      "type": "string",
      "description": "Unique NFC tag ID"
    },
    "profile_url": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "booth_number": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "tap_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}