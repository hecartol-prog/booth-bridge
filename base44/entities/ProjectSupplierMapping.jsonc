{
  "name": "ProjectSupplierMapping",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "UUID ref to SourcingProject"
    },
    "buyer_id": {
      "type": "string",
      "description": "Denormalized for RLS \u2014 matches SourcingProject.buyer_id"
    },
    "exhibitor_user_id": {
      "type": "string"
    },
    "exhibitor_profile_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "booth_number": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "evaluation_notes": {
      "type": "string"
    },
    "moq": {
      "type": "number"
    },
    "lead_time_days": {
      "type": "number"
    },
    "certifications": {
      "type": "string"
    },
    "tooling_capability": {
      "type": "string"
    },
    "export_markets": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "1-5 buyer rating"
    },
    "status": {
      "type": "string",
      "enum": [
        "shortlisted",
        "contacted",
        "sample_requested",
        "approved",
        "rejected"
      ],
      "default": "shortlisted"
    }
  },
  "required": [
    "project_id",
    "buyer_id",
    "exhibitor_user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}