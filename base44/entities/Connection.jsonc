{
  "name": "Connection",
  "type": "object",
  "properties": {
    "exhibitor_user_id": {
      "type": "string"
    },
    "buyer_user_id": {
      "type": "string"
    },
    "exhibitor_profile_id": {
      "type": "string"
    },
    "buyer_profile_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "initiated_by": {
      "type": "string",
      "enum": [
        "exhibitor",
        "buyer"
      ]
    },
    "exhibitor_notes": {
      "type": "string"
    },
    "buyer_notes": {
      "type": "string"
    },
    "exhibitor_company": {
      "type": "string"
    },
    "buyer_company": {
      "type": "string"
    },
    "exhibitor_name": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "booth_number": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    }
  },
  "required": [
    "exhibitor_user_id",
    "buyer_user_id",
    "status"
  ]
}