{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/types/**/*.d.ts",
    "src/api/**/*.js",
    "src/config/**/*.js",
    "src/ai/**/*.js",
    "src/components/**/*.jsx",
    "src/pages/**/*.jsx",
    "src/monitoring/**/*.js",
    "src/monitoring/**/*.jsx",
    "src/Layout.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/vite-plugins",
    "src/components/ui/**",
    "src/lib/**"
  ]
}
