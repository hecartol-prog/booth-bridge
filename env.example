# Copy to .env.local for local dev (never commit .env.local).
# Production: set VITE_* in Vercel; Google secret ONLY in Supabase Dashboard.

VITE_SUPABASE_URL=https://jjqhmvfzqpohvukoxeoe.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_APP_URL=https://www.boothbridge.app
VITE_GOOGLE_CLIENT_ID=648553460870-29f0bd8daaov3p0gi52h0sbjdagkiipt.apps.googleusercontent.com

# RC10.5 Developer debug console (local only — requires authenticated Supabase admin session)
# VITE_DEBUG_MODE=true
# VITE_DISABLE_DEBUG_CONSOLE=true

# RC10.6 Sentry production monitoring (enabled only when DSN is set)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=booth-bridge@0.0.0+commit
# SENTRY_AUTH_TOKEN=...        # CI / build only — uploads source maps
# SENTRY_ORG=your-org
# SENTRY_PROJECT=booth-bridge
# SENTRY_DSN=...               # Supabase Edge Function secret (optional)

# OCR model overrides (optional)
# VITE_RC10_VISION_MODEL=qwen/qwen-2.5-vl-72b-instruct
# VITE_RC10_NORMALIZE_MODEL=qwen/qwen-2.5-72b-instruct

# RC9 AI runtime (Supabase Edge secrets — not VITE_*)
# DEBUG_AI=true
# AI_MODEL=qwen/qwen-2.5-vl-72b-instruct
# AI_PROVIDER_ORDER=qwen
# AI_ENABLE_DIRECT_OPENAI_FALLBACK=false
# OPENROUTER_API_KEY=or-...
# AI_REQUEST_TIMEOUT_MS=30000

# Local Supabase CLI only (not for Vercel / not VITE_*)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=648553460870-29f0bd8daaov3p0gi52h0sbjdagkiipt.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Playwright E2E (optional — authenticated route tests skip when unset)
# Required for local E2E: uncomment and set VITE_SUPABASE_ANON_KEY in .env.local
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5199
# E2E_EXHIBITOR_EMAIL=exhibitor@example.com
# E2E_EXHIBITOR_PASSWORD=your_exhibitor_password
# E2E_BUYER_EMAIL=buyer@example.com
# E2E_BUYER_PASSWORD=your_buyer_password
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=your_admin_password
